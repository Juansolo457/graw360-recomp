+// Whether the function calls through LR (blrl, bclrl). Under skip_lr such a function still
+// loads LR: the C runtime's _CallSettingFrame (mtlr r3; blrl) calls an SEH funclet that way.
+static bool CallsThroughLr(const BuilderContext& ctx) {
+  const uint32_t* insn = ctx.data - (ctx.base - ctx.fn.base()) / 4;
+  for (uint32_t address = ctx.fn.base(); address < ctx.fn.end(); address += 4, ++insn) {
+    if ((byte_swap(*insn) & 0xFC0007FF) == 0x4C000021)
+      return true;
+  }
+  return false;
+}
+
 bool build_mtlr(BuilderContext& ctx) {
-  if (!ctx.config().skipLr)
+  if (!ctx.config().skipLr || CallsThroughLr(ctx))
     ctx.println("\tctx.lr = {}.u64;", ctx.r(ctx.insn.operands[0]));
   return true;
 }
