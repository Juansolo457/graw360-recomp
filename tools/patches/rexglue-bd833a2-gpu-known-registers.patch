+#include <array>
 #include <algorithm>
 #include <cinttypes>
 #include <cmath>
@@ -361,7 +362,16 @@ void CommandProcessor::WriteRegister(uint32_t index, uint32_t value) {
 
   // Volatile for the WAIT_REG_MEM loop.
   const_cast<volatile uint32_t&>(regs.values[index]) = value;
-  if (!regs.GetRegisterInfo(index)) {
+  // Which registers the table names, worked out once: GetRegisterInfo is a switch over the whole
+  // table with a guarded static per case, and this runs for every register write of every packet.
+  static const auto known_registers = [&regs] {
+    std::array<bool, RegisterFile::kRegisterCount> known{};
+    for (uint32_t i = 0; i < RegisterFile::kRegisterCount; ++i) {
+      known[i] = regs.GetRegisterInfo(i) != nullptr;
+    }
+    return known;
+  }();
+  if (!known_registers[index]) {
     REXGPU_DEBUG("GPU: Write to unknown register ({:04X} = {:08X})", index, value);
