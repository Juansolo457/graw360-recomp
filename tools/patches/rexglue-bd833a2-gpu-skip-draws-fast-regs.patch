+bool CommandProcessor::IsPlainRegisterRange(uint32_t first, uint32_t last) const {
+  // Registers WriteRegister acts on beyond storing the value: the scratch write-backs, the
+  // coherency dirty bit and the gamma ramp. Everything else is state the backends read at draw
+  // time, which gpu_skip_draws never reaches.
+  static constexpr std::pair<uint32_t, uint32_t> special[] = {
+      {XE_GPU_REG_SCRATCH_REG0, XE_GPU_REG_SCRATCH_REG7},
+      {XE_GPU_REG_COHER_STATUS_HOST, XE_GPU_REG_COHER_STATUS_HOST},
+      {XE_GPU_REG_DC_LUT_RW_INDEX, XE_GPU_REG_DC_LUT_RW_INDEX},
+      {XE_GPU_REG_DC_LUT_SEQ_COLOR, XE_GPU_REG_DC_LUT_SEQ_COLOR},
+      {XE_GPU_REG_DC_LUT_PWL_DATA, XE_GPU_REG_DC_LUT_PWL_DATA},
+      {XE_GPU_REG_DC_LUT_30_COLOR, XE_GPU_REG_DC_LUT_30_COLOR},
+  };
+  if (last >= RegisterFile::kRegisterCount || first > last) return false;
+  for (const auto& [a, b] : special) {
+    if (first <= b && last >= a) return false;
+  }
+  return true;
+}
