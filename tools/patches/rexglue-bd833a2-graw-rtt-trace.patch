diff --git a/include/rex/graphics/graw_trace.h b/include/rex/graphics/graw_trace.h
new file mode 100644
index 0000000..be24ebd
--- /dev/null
+++ b/include/rex/graphics/graw_trace.h
@@ -0,0 +1,128 @@
+// GRAW #2 instrumentation (local only, never upstreamed): traces small render-to-texture
+// resolves and every texture-cache event on their destination ranges, so a black video panel
+// can be followed from the resolve to the texture the HUD samples. Off unless
+// --graw_trace_rtt_max_width > 0 (resolves at most that wide are traced).
+#pragma once
+
+#include <chrono>
+#include <cstdint>
+#include <map>
+#include <mutex>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include <rex/cvar.h>
+#include <rex/logging.h>
+
+REXCVAR_DECLARE(uint32_t, graw_trace_rtt_max_width);
+
+namespace rex::graphics::graw_trace {
+
+struct State {
+  std::mutex mutex;
+  std::vector<std::pair<uint32_t, uint32_t>> ranges;  // traced resolve destinations
+  std::map<std::string, uint64_t> counts;             // per 2 s
+  std::map<std::string, uint32_t> detailed;           // lines logged per event key
+  std::chrono::steady_clock::time_point window = std::chrono::steady_clock::now();
+};
+
+inline State& Get() {
+  static State state;
+  return state;
+}
+
+inline bool Enabled() { return REXCVAR_GET(graw_trace_rtt_max_width) != 0; }
+
+// Is any byte of [start, start + length) inside a traced resolve destination?
+inline bool Tracked(uint32_t start, uint32_t length) {
+  State& s = Get();
+  std::lock_guard<std::mutex> lock(s.mutex);
+  start &= 0x1FFFFFFF;
+  for (const auto& [base, size] : s.ranges) {
+    if (start < base + size && base < start + length) return true;
+  }
+  return false;
+}
+
+inline void Track(uint32_t start, uint32_t length) {
+  State& s = Get();
+  std::lock_guard<std::mutex> lock(s.mutex);
+  start &= 0x1FFFFFFF;
+  for (const auto& r : s.ranges) {
+    if (r.first == start && r.second == length) return;
+  }
+  if (s.ranges.size() < 64) s.ranges.emplace_back(start, length);
+}
+
+// Counts an event, and returns true if it should also be logged in full (the first `limit`
+// times for this key). Logs a summary of all counts every 2 s.
+inline bool Count(const std::string& key, uint32_t limit = 6) {
+  State& s = Get();
+  std::lock_guard<std::mutex> lock(s.mutex);
+  ++s.counts[key];
+  auto now = std::chrono::steady_clock::now();
+  if (now - s.window >= std::chrono::seconds(2)) {
+    s.window = now;
+    std::string line;
+    for (const auto& [k, v] : s.counts) line += " | " + k + " x" + std::to_string(v);
+    REXGPU_INFO("GRAW trace last 2 s:{}", line);
+    s.counts.clear();
+  }
+  return s.detailed[key]++ < limit;
+}
+
+// #1: history of shared-memory events (G = written by the GPU, I = invalidated by the CPU,
+// U = uploaded from guest memory), to explain a stale texture after the fact.
+struct Event {
+  char kind;
+  uint32_t start, length;
+  uint32_t ms;
+};
+inline std::vector<Event>& History() {
+  static std::vector<Event> h;
+  return h;
+}
+inline void Note(char kind, uint32_t start, uint32_t length) {
+  if (!Enabled()) return;
+  static const auto t0 = std::chrono::steady_clock::now();
+  State& s = Get();
+  std::lock_guard<std::mutex> lock(s.mutex);
+  auto& h = History();
+  if (h.size() >= 4000000) return;
+  h.push_back({kind, start, length,
+               uint32_t(std::chrono::duration_cast<std::chrono::milliseconds>(
+                            std::chrono::steady_clock::now() - t0)
+                            .count())});
+}
+inline void DumpOverlapping(uint32_t base, uint32_t length) {
+  State& s = Get();
+  std::lock_guard<std::mutex> lock(s.mutex);
+  // Runs of the same event are collapsed into one line (first and last time, count).
+  uint32_t logged = 0, total = 0;
+  const Event* run = nullptr;
+  uint32_t run_count = 0, run_last = 0;
+  auto flush = [&] {
+    if (run && logged++ < 600) {
+      REXGPU_INFO("GRAW history {:08X}: {} {:08X}+{:X} x{} at {}..{} ms", base, run->kind,
+                  run->start, run->length, run_count, run->ms, run_last);
+    }
+  };
+  for (const Event& e : History()) {
+    if (!(e.start < base + length && base < e.start + e.length)) continue;
+    ++total;
+    if (run && run->kind == e.kind && run->start == e.start && run->length == e.length) {
+      ++run_count;
+      run_last = e.ms;
+      continue;
+    }
+    flush();
+    run = &e;
+    run_count = 1;
+    run_last = e.ms;
+  }
+  flush();
+  REXGPU_INFO("GRAW history {:08X}: {} events overlap (of {})", base, total, History().size());
+}
+
+}  // namespace rex::graphics::graw_trace
