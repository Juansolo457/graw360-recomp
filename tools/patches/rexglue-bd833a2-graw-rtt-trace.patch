+namespace {
+// GRAW #2 trace: what happens to draws into narrow render targets (the video panels).
+void GrawNoteDraw(const RegisterFile& regs, const char* outcome, const void* pixel_shader,
+                  uint32_t normalized_color_mask, uint32_t vertices) {
+  auto si = regs.Get<reg::RB_SURFACE_INFO>();
+  auto ci = regs.Get<reg::RB_COLOR_INFO>(reg::RB_COLOR_INFO::rt_register_indices[0]);
+  std::string key = fmt::format("draw pitch {} base {} fmt {} msaa {}: {}",
+                                uint32_t(si.surface_pitch), uint32_t(ci.color_base),
+                                uint32_t(ci.color_format), uint32_t(si.msaa_samples), outcome);
+  if (!graw_trace::Count(key, 3)) return;
+  REXGPU_INFO(
+      "GRAW trace {}: ps {} color_mask {:08X} normalized {:X} vte {:08X} clip {:08X} "
+      "mode_cntl {:08X} blend0 {:08X} colorcontrol {:08X} depthctl {:08X} modecontrol {:08X} "
+      "window_offset {:08X} window_scissor {:08X} {:08X} screen_scissor {:08X} {:08X} "
+      "vport scale {} {} offset {} {} verts {}",
+      key, pixel_shader, regs[XE_GPU_REG_RB_COLOR_MASK], normalized_color_mask,
+      regs[XE_GPU_REG_PA_CL_VTE_CNTL], regs[XE_GPU_REG_PA_CL_CLIP_CNTL],
+      regs[XE_GPU_REG_PA_SU_SC_MODE_CNTL], regs[XE_GPU_REG_RB_BLENDCONTROL0],
+      regs[XE_GPU_REG_RB_COLORCONTROL], regs[XE_GPU_REG_RB_DEPTHCONTROL],
+      regs[XE_GPU_REG_RB_MODECONTROL], regs[XE_GPU_REG_PA_SC_WINDOW_OFFSET],
+      regs[XE_GPU_REG_PA_SC_WINDOW_SCISSOR_TL], regs[XE_GPU_REG_PA_SC_WINDOW_SCISSOR_BR],
+      regs[XE_GPU_REG_PA_SC_SCREEN_SCISSOR_TL], regs[XE_GPU_REG_PA_SC_SCREEN_SCISSOR_BR],
+      regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_XSCALE), regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_YSCALE),
+      regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_XOFFSET),
+      regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_YOFFSET), vertices);
+}
+// Logs the textures a traced draw samples and starts tracing texture-cache events on them.
+// GRAW #2 blend trace: around each HUD draw of a 160x120 video texture, log the next draws'
+// RB_BLENDCONTROL0 and every RB_BLENDCONTROL0 write the guest makes in between.
+struct GrawBlendTrace {
+  int armed = 0;      // draws still to log after a video draw
+  int dumps = 0;      // video draws logged so far
+  uint64_t writes = 0;
+  uint32_t last_value = 0;
+};
+GrawBlendTrace g_graw_blend;
+
+void GrawNoteBlendWrite(uint32_t value) {
+  ++g_graw_blend.writes;
+  if (g_graw_blend.armed > 0) {
+    REXGPU_INFO("GRAW blend   write RB_BLENDCONTROL0 {:08X} (previous {:08X}, write #{})", value,
+                g_graw_blend.last_value, g_graw_blend.writes);
+  }
+  g_graw_blend.last_value = value;
+}
+
+std::string GrawFetchSummary(const RegisterFile& regs, uint32_t used_texture_mask, bool* video) {
+  std::string out;
+  uint32_t index;
+  uint32_t mask = used_texture_mask;
+  while (rex::bit_scan_forward(mask, &index)) {
+    mask &= ~(UINT32_C(1) << index);
+    xenos::xe_gpu_texture_fetch_t f = regs.GetTextureFetch(index);
+    uint32_t w = f.size_2d.width + 1, h = f.size_2d.height + 1;
+    if (w == 160 && h == 120 && uint32_t(f.format) == 6) *video = true;
+    out += fmt::format(" t{}={:08X}:{}x{}:f{}", index, uint32_t(f.base_address) << 12, w, h,
+                       uint32_t(f.format));
+  }
+  return out;
+}
+
+void GrawNoteBlendDraw(const RegisterFile& regs, uint32_t used_texture_mask, uint32_t verts,
+                       bool indexed) {
+  bool video = false;
+  std::string fetches = GrawFetchSummary(regs, used_texture_mask, &video);
+  if (video && g_graw_blend.dumps < 3 && g_graw_blend.armed == 0) {
+    ++g_graw_blend.dumps;
+    g_graw_blend.armed = 12;
+    REXGPU_INFO("GRAW blend VIDEO draw #{}: blend0 {:08X} colorcontrol {:08X} verts {}{}",
+                g_graw_blend.dumps, regs[XE_GPU_REG_RB_BLENDCONTROL0],
+                regs[XE_GPU_REG_RB_COLORCONTROL], verts, fetches);
+    return;
+  }
+  if (g_graw_blend.armed > 0) {
+    --g_graw_blend.armed;
+    REXGPU_INFO("GRAW blend   draw{}: blend0 {:08X} colorcontrol {:08X} mask {:08X} verts {}{}",
+                indexed ? " indexed" : "", regs[XE_GPU_REG_RB_BLENDCONTROL0],
+                regs[XE_GPU_REG_RB_COLORCONTROL], regs[XE_GPU_REG_RB_COLOR_MASK], verts, fetches);
+  }
+}
+
+const memory::Memory*& GrawMemory() {
+  static const memory::Memory* memory = nullptr;
+  return memory;
+}
+
+// #1: for draws sampling a 1280x720 8:8:8:8 texture (the scene copy), log once per distinct set
+// the registers that place screen-space geometry: VTE control, window offset, viewport
+// scale/offset, surface pitch/MSAA, and the window scissor.
+void GrawNoteSceneComposite(const RegisterFile& regs, uint32_t used_texture_mask) {
+  uint32_t index, mask = used_texture_mask;
+  bool hit = false;
+  while (rex::bit_scan_forward(mask, &index)) {
+    mask &= ~(UINT32_C(1) << index);
+    const xenos::xe_gpu_texture_fetch_t f = regs.GetTextureFetch(index);
+    if (f.size_2d.width + 1 == 1280 && f.size_2d.height + 1 == 720 && uint32_t(f.format) == 6) {
+      hit = true;
+    }
+  }
+  if (!hit) return;
+  auto fl = [&](uint32_t r) {
+    float v;
+    std::memcpy(&v, &regs[r], 4);
+    return v;
+  };
+  const std::string key = fmt::format(
+      "composite vte {:08X} winoff {:08X} vport x {} {} y {} {} surface {:08X} mode {:08X} "
+      "wscissor {:08X} {:08X}",
+      regs[XE_GPU_REG_PA_CL_VTE_CNTL], regs[XE_GPU_REG_PA_SC_WINDOW_OFFSET],
+      fl(XE_GPU_REG_PA_CL_VPORT_XSCALE), fl(XE_GPU_REG_PA_CL_VPORT_XOFFSET),
+      fl(XE_GPU_REG_PA_CL_VPORT_YSCALE), fl(XE_GPU_REG_PA_CL_VPORT_YOFFSET),
+      regs[XE_GPU_REG_RB_SURFACE_INFO], regs[XE_GPU_REG_PA_SU_SC_MODE_CNTL],
+      regs[XE_GPU_REG_PA_SC_WINDOW_SCISSOR_TL], regs[XE_GPU_REG_PA_SC_WINDOW_SCISSOR_BR]);
+  if (graw_trace::Count(key, 3)) REXGPU_INFO("GRAW {}", key);
+}
+
+// #1: the edge-blur grid (samples a 256x200 8:8:8:8 texture and draws indexed): its first 32
+// vertex shader float constants, once per distinct set.
+void GrawNoteGridConstants(const RegisterFile& regs, uint32_t used_texture_mask) {
+  uint32_t index, mask = used_texture_mask;
+  bool hit = false;
+  while (rex::bit_scan_forward(mask, &index)) {
+    mask &= ~(UINT32_C(1) << index);
+    const xenos::xe_gpu_texture_fetch_t f = regs.GetTextureFetch(index);
+    if (f.size_2d.width + 1 == 256 && f.size_2d.height + 1 == 200 && uint32_t(f.format) == 6 &&
+        regs.Get<reg::RB_SURFACE_INFO>().surface_pitch == 1280) {
+      hit = true;
+    }
+  }
+  if (!hit) return;
+  std::string c;
+  for (uint32_t i = 0; i < 32 * 4; ++i) {
+    float v;
+    std::memcpy(&v, &regs[XE_GPU_REG_SHADER_CONSTANT_000_X + i], 4);
+    c += fmt::format("{}{:.4g}", (i % 4) ? "," : (i ? " | " : ""), v);
+  }
+  if (graw_trace::Count("grid " + c, 2)) REXGPU_INFO("GRAW grid vs constants: {}", c);
+  // Its vertex streams: each vertex-type fetch constant, and the first 24 floats of its data.
+  for (uint32_t i = 0; i < 96; ++i) {
+    const xenos::xe_gpu_vertex_fetch_t vf = regs.GetVertexFetch(i);
+    if (vf.type != xenos::FetchConstantType::kVertex || !vf.address) continue;
+    const uint32_t address = vf.address << 2;
+    const uint8_t* data = GrawMemory() ? GrawMemory()->TranslatePhysical<const uint8_t*>(address) : nullptr;
+    std::string v;
+    for (uint32_t k = 0; data && k < std::min<uint32_t>(24, vf.size); ++k) {
+      uint32_t w;
+      std::memcpy(&w, data + 4 * k, 4);
+      w = rex::byte_swap(w);
+      float f;
+      std::memcpy(&f, &w, 4);
+      v += fmt::format(" {:.4g}", f);
+    }
+    const std::string line =
+        fmt::format("grid vfetch {} address {:08X} words {} endian {}:{}", i, address,
+                    uint32_t(vf.size), uint32_t(vf.endian), v);
+    if (graw_trace::Count(line, 1)) REXGPU_INFO("GRAW {}", line);
+  }
+}
+
+void GrawNoteDrawTextures(const RegisterFile& regs, uint32_t used_texture_mask) {
+  GrawNoteSceneComposite(regs, used_texture_mask);
+  GrawNoteGridConstants(regs, used_texture_mask);
+  auto si = regs.Get<reg::RB_SURFACE_INFO>();
+  uint32_t index;
+  uint32_t mask = used_texture_mask;
+  while (rex::bit_scan_forward(mask, &index)) {
+    mask &= ~(UINT32_C(1) << index);
+    xenos::xe_gpu_texture_fetch_t fetch = regs.GetTextureFetch(index);
+    uint32_t base = fetch.base_address << 12;
+    uint32_t w = fetch.size_2d.width + 1, h = fetch.size_2d.height + 1;
+    graw_trace::Track(base, std::max(UINT32_C(0x1000), w * h * 4));
+    std::string key = fmt::format("draw pitch {} samples fetch {} base {:08X} {}x{} fmt {}",
+                                  uint32_t(si.surface_pitch), index, base, w, h,
+                                  uint32_t(fetch.format));
+    if (graw_trace::Count(key, 2)) {
