+// #1: after the scene composite (vs 54BAEAB9C0C06F2E), log the next 40 draws, 3 times.
+void GrawSeq(const RegisterFile& regs, uint32_t used_texture_mask, uint64_t vs, uint64_t ps,
+             uint32_t verts, bool indexed) {
+  {
+    // #1: dump the guest bytes of the HUD atlas (512x256 DXT3, dword0 84024802) once after 58 s.
+    static bool dumped = false;
+    static const auto t0 = std::chrono::steady_clock::now();
+    uint32_t si2, sm2 = used_texture_mask;
+    while (!dumped && rex::bit_scan_forward(sm2, &si2)) {
+      sm2 &= ~(UINT32_C(1) << si2);
+      const xenos::xe_gpu_texture_fetch_t f = regs.GetTextureFetch(si2);
+      if (f.dword_0 == 0x84024802u && f.size_2d.width == 511 && f.size_2d.height == 255 &&
+          uint32_t(f.format) == 19 && GrawMemory() &&
+          std::chrono::steady_clock::now() - t0 > std::chrono::seconds(58)) {
+        dumped = true;
+        const uint32_t base = uint32_t(f.base_address) << 12;
+        const uint8_t* src = GrawMemory()->TranslatePhysical<const uint8_t*>(base);
+        const std::string name = fmt::format("graw-atlas-{:08X}.bin", base);
+        if (FILE* out = std::fopen(name.c_str(), "wb")) {
+          std::fwrite(src, 1, 0x20000, out);
+          std::fclose(out);
+        }
+        graw_trace::DumpOverlapping(base, 0x20000);
+        REXGPU_INFO("GRAW atlas dump {} (fetch {:08X} {:08X} {:08X} {:08X} {:08X} {:08X})", name,
+                    f.dword_0, f.dword_1, f.dword_2, f.dword_3, f.dword_4, f.dword_5);
+      }
+    }
+  }
+  if (vs == UINT64_C(0xD46836FDA9466337)) {
+    // #3: the tactical map composite. Its constants (VS c0-c8, c114, c255; PS c31) and vertices.
+    static int map_logs = 0;
+    if (map_logs < 400 && (++map_logs % 100) == 1) {
+      std::string c;
+      for (uint32_t ci : {0u, 1u, 2u, 3u, 4u, 5u, 6u, 7u, 8u, 114u, 255u, 256u + 31u}) {
+        c += fmt::format(" c{}=", ci);
+        for (uint32_t e = 0; e < 4; ++e) {
+          float v;
+          std::memcpy(&v, &regs[XE_GPU_REG_SHADER_CONSTANT_000_X + ci * 4 + e], 4);
+          c += fmt::format("{}{:.6g}", e ? "," : "", v);
+        }
+      }
+      REXGPU_INFO("GRAW map c:{}", c);
+      for (uint32_t i = 0; i < 96; ++i) {
+        const xenos::xe_gpu_vertex_fetch_t vf = regs.GetVertexFetch(i);
+        if (vf.type != xenos::FetchConstantType::kVertex || !vf.address || !vf.size ||
+            vf.size > 0x400 || !GrawMemory()) {
+          continue;
+        }
+        const uint8_t* d = GrawMemory()->TranslatePhysical<const uint8_t*>(vf.address << 2);
+        std::string f;
+        for (uint32_t w = 0; w < std::min<uint32_t>(vf.size, 36); ++w) {
+          uint32_t v;
+          std::memcpy(&v, d + 4 * w, 4);
+          if (vf.endian == xenos::Endian::k8in32) v = rex::byte_swap(v);
+          float x;
+          std::memcpy(&x, &v, 4);
+          f += fmt::format("{}{:.5g}", (w % 9) ? "," : " | ", x);
+        }
+        REXGPU_INFO("GRAW map vfetch {} {:08X} words {} endian {}:{}", i, vf.address << 2,
+                    uint32_t(vf.size), uint32_t(vf.endian), f);
+      }
+    }
+  }
+  if (vs == UINT64_C(0x9932BC1F8BCC0099)) {
+    // The edge grid: oPos = pos16 * c255.xxyy + c255.yyzx; also c8-c10, c251-c254.
+    std::string c;
+    for (uint32_t ci : {8u, 9u, 10u, 251u, 252u, 253u, 254u, 255u}) {
+      c += fmt::format(" c{}=", ci);
+      for (uint32_t e = 0; e < 4; ++e) {
+        float v;
+        std::memcpy(&v, &regs[XE_GPU_REG_SHADER_CONSTANT_000_X + ci * 4 + e], 4);
+        c += fmt::format("{}{:.6g}", e ? "," : "", v);
+      }
+    }
+    static int grid_logs = 0;
+    if (grid_logs < 400 && (++grid_logs % 50) == 0) {
+      REXGPU_INFO("GRAW grid c:{}", c);
+      // Its vertex data: every vertex fetch constant, min/max of the int16 pairs (x, y).
+      for (uint32_t i = 0; i < 96; ++i) {
+        const xenos::xe_gpu_vertex_fetch_t vf = regs.GetVertexFetch(i);
+        if (vf.type != xenos::FetchConstantType::kVertex || !vf.address || !vf.size ||
+            vf.size > 0x10000 || !GrawMemory()) {
+          continue;
+        }
+        const uint8_t* d = GrawMemory()->TranslatePhysical<const uint8_t*>(vf.address << 2);
+        for (uint32_t field = 0; field < 2; ++field) {
+          int minx = 99999, maxx = -99999, miny = 99999, maxy = -99999;
+          std::string first;
+          for (uint32_t w = field; w < vf.size; w += 2) {
+            uint32_t v;
+            std::memcpy(&v, d + 4 * w, 4);
+            v = rex::byte_swap(v);
+            const int x = int16_t(v >> 16), y = int16_t(v & 0xFFFF);
+            minx = std::min(minx, x), maxx = std::max(maxx, x);
+            miny = std::min(miny, y), maxy = std::max(maxy, y);
+            if (w < 2 * 24) first += fmt::format(" {},{}", x, y);
+          }
+          REXGPU_INFO("GRAW grid vfetch {} address {:08X} words {} endian {} field {} hi {}..{} "
+                      "lo {}..{} first:{}",
+                      i, vf.address << 2, uint32_t(vf.size), uint32_t(vf.endian), field, minx,
+                      maxx, miny, maxy, first);
+        }
+      }
+    }
+  }
+  int& seq_left = GrawSeqLeft();
+  static int seq_runs = 0;
+  static const auto start = std::chrono::steady_clock::now();
+  const auto elapsed = std::chrono::steady_clock::now() - start;
+  if (vs == UINT64_C(0x54BAEAB9C0C06F2E) && seq_left == 0 &&
+      ((seq_runs == 0 && elapsed > std::chrono::seconds(REXCVAR_GET(graw_seq_at))) ||
+       (seq_runs == 1 && elapsed > std::chrono::seconds(REXCVAR_GET(graw_seq_at) + 7)))) {
+    seq_left = 400;
+    ++seq_runs;
+  }
+  static int seq_index = 0;
+  if (vs == UINT64_C(0x54BAEAB9C0C06F2E)) seq_index = 0; else ++seq_index;
+  if (seq_left <= 0) return;
+  --seq_left;
+  std::string t;
+  uint32_t si, sm = used_texture_mask;
+  while (rex::bit_scan_forward(sm, &si)) {
+    sm &= ~(UINT32_C(1) << si);
+    const xenos::xe_gpu_texture_fetch_t sf = regs.GetTextureFetch(si);
+    t += fmt::format(" t{}={:08X}:{}x{}:f{}", si, uint32_t(sf.base_address) << 12,
+                     sf.size_2d.width + 1, sf.size_2d.height + 1, uint32_t(sf.format));
+  }
+  REXGPU_INFO("GRAW seq {} #{} vs {:016X} ps {:016X} verts {}{} pitch {} vte {:08X} blend {:08X} "
+              "depthctl {:08X} winoff {:08X} vport {:08X} {:08X} {:08X} {:08X} color0 {:08X} scis {:08X} {:08X}{}",
+              seq_runs, seq_index, vs, ps, verts, indexed ? " indexed" : "",
+              uint32_t(regs.Get<reg::RB_SURFACE_INFO>().surface_pitch),
+              regs[XE_GPU_REG_PA_CL_VTE_CNTL], regs[XE_GPU_REG_RB_BLENDCONTROL0],
+              regs[XE_GPU_REG_RB_DEPTHCONTROL], regs[XE_GPU_REG_PA_SC_WINDOW_OFFSET],
+              regs[XE_GPU_REG_PA_CL_VPORT_XSCALE], regs[XE_GPU_REG_PA_CL_VPORT_XOFFSET],
+              regs[XE_GPU_REG_PA_CL_VPORT_YSCALE], regs[XE_GPU_REG_PA_CL_VPORT_YOFFSET],
+              regs[XE_GPU_REG_RB_COLOR_INFO], regs[XE_GPU_REG_PA_SC_WINDOW_SCISSOR_TL],
+              regs[XE_GPU_REG_PA_SC_WINDOW_SCISSOR_BR], t);
+}
+
+REXCVAR_DEFINE_STRING(graw_skip_sampling, "", "GPU",
+                      "GRAW #1 experiment: drop draws that sample a texture whose base address is in "
+                      "this comma-separated hex list");
+
+namespace {
+bool GrawSkipBySampling(const RegisterFile& regs, uint32_t used_texture_mask,
+                        uint64_t vs_hash = 0) {
+  static const std::vector<uint32_t> list = [] {
+    std::vector<uint32_t> v;
+    std::string spec = REXCVAR_GET(graw_skip_sampling);
+    size_t start = 0;
+    while (start < spec.size()) {
+      size_t end = spec.find(',', start);
+      if (end == std::string::npos) end = spec.size();
+      const std::string item = spec.substr(start, end - start);
+      char* stop = nullptr;
+      const unsigned long value = std::strtoul(item.c_str(), &stop, 16);
+      if (stop != item.c_str() && item != "k8" && item.find('x') == std::string::npos) v.push_back(uint32_t(value));
+      start = end + 1;
+    }
+    REXGPU_INFO("GRAW skip sampling: '{}' -> {} addresses", spec, v.size());
+    return v;
+  }();
+  // "k8": any untiled single-channel (k_8) texture at least 640 wide - the CPU-written ones the
+  // tutorial's composition samples (their addresses move between runs).
+  static const bool k8 = REXCVAR_GET(graw_skip_sampling).find("k8") != std::string::npos;
+  // "WxHfF" items (e.g. 512x256f19): any texture of that size and format.
+  static const std::vector<std::array<uint32_t, 3>> sizes = [] {
+    std::vector<std::array<uint32_t, 3>> v;
+    std::stringstream in(REXCVAR_GET(graw_skip_sampling));
+    std::string item;
+    while (std::getline(in, item, ',')) {
+      unsigned w, h, f;
+      if (std::sscanf(item.c_str(), "%ux%uf%u", &w, &h, &f) == 3) v.push_back({w, h, f});
+    }
+    return v;
+  }();
+  if (list.empty() && !k8 && sizes.empty()) return false;
+  // A listed value equal to the vertex shader hash's low 32 bits also drops the draw.
+  if (vs_hash && std::find(list.begin(), list.end(), uint32_t(vs_hash)) != list.end()) return true;
+  uint32_t index, mask = used_texture_mask;
+  while (rex::bit_scan_forward(mask, &index)) {
+    mask &= ~(UINT32_C(1) << index);
+    const xenos::xe_gpu_texture_fetch_t fetch = regs.GetTextureFetch(index);
+    const uint32_t base = fetch.base_address << 12;
+    if (std::find(list.begin(), list.end(), base) != list.end()) return true;
+    for (const auto& z : sizes) {
+      if (fetch.size_2d.width + 1 == z[0] && fetch.size_2d.height + 1 == z[1] &&
+          uint32_t(fetch.format) == z[2]) {
+        return true;
+      }
+    }
+    if (k8 && uint32_t(fetch.format) == 2 && !fetch.tiled && fetch.size_2d.width + 1 >= 640) {
+      return true;
+    }
+  }
+  return false;
+}
