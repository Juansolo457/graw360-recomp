+// GRAW #2 instrumentation (local only, never upstreamed): traces small render-to-texture
+// resolves and every texture-cache event on their destination ranges, so a black video panel
+// can be followed from the resolve to the texture the HUD samples. Off unless
+// --graw_trace_rtt_max_width > 0 (resolves at most that wide are traced).
+#pragma once
+
+#include <chrono>
+#include <cstdint>
+#include <map>
+#include <mutex>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include <rex/cvar.h>
+#include <rex/logging.h>
+
+REXCVAR_DECLARE(uint32_t, graw_trace_rtt_max_width);
+
+namespace rex::graphics::graw_trace {
+
+struct State {
+  std::mutex mutex;
+  std::vector<std::pair<uint32_t, uint32_t>> ranges;  // traced resolve destinations
+  std::map<std::string, uint64_t> counts;             // per 2 s
+  std::map<std::string, uint32_t> detailed;           // lines logged per event key
+  std::chrono::steady_clock::time_point window = std::chrono::steady_clock::now();
+};
+
+inline State& Get() {
+  static State state;
+  return state;
+}
+
+inline bool Enabled() { return REXCVAR_GET(graw_trace_rtt_max_width) != 0; }
+
+// Is any byte of [start, start + length) inside a traced resolve destination?
+inline bool Tracked(uint32_t start, uint32_t length) {
+  State& s = Get();
+  std::lock_guard<std::mutex> lock(s.mutex);
+  start &= 0x1FFFFFFF;
+  for (const auto& [base, size] : s.ranges) {
+    if (start < base + size && base < start + length) return true;
+  }
+  return false;
+}
+
+inline void Track(uint32_t start, uint32_t length) {
+  State& s = Get();
+  std::lock_guard<std::mutex> lock(s.mutex);
+  start &= 0x1FFFFFFF;
+  for (const auto& r : s.ranges) {
+    if (r.first == start && r.second == length) return;
+  }
+  if (s.ranges.size() < 64) s.ranges.emplace_back(start, length);
+}
+
+// Counts an event, and returns true if it should also be logged in full (the first `limit`
+// times for this key). Logs a summary of all counts every 2 s.
+inline bool Count(const std::string& key, uint32_t limit = 6) {
+  State& s = Get();
+  std::lock_guard<std::mutex> lock(s.mutex);
+  ++s.counts[key];
+  auto now = std::chrono::steady_clock::now();
+  if (now - s.window >= std::chrono::seconds(2)) {
+    s.window = now;
+    std::string line;
+    for (const auto& [k, v] : s.counts) line += " | " + k + " x" + std::to_string(v);
+    REXGPU_INFO("GRAW trace last 2 s:{}", line);
+    s.counts.clear();
+  }
+  return s.detailed[key]++ < limit;
+}
+
+}  // namespace rex::graphics::graw_trace
