+void D3D12TextureCache::GrawLogHudBindings(uint32_t used_mask) {
+  for (uint32_t i = 0; i < 32; ++i) {
+    if (i >= 16 && !(used_mask & (1u << i))) continue;
+    const TextureBinding* binding = GetValidTextureBinding(i);
+    if (!binding) {
+      REXGPU_INFO("GRAW HUD sampler {} used {} no valid cached binding", i, bool(used_mask & (1u << i)));
+      continue;
+    }
+    const auto& native = d3d12_texture_bindings_[i];
+    auto* texture = static_cast<D3D12Texture*>(binding->texture);
+    auto* signed_texture = static_cast<D3D12Texture*>(binding->texture_signed);
+    REXGPU_INFO("GRAW HUD sampler {} used {} physical {:08X} {}x{} host_swizzle {:X} "
+                "descriptor {} signed_descriptor {} resource {} signed_resource {}",
+                i, bool(used_mask & (1u << i)), uint32_t(binding->key.base_page) << 12,
+                binding->key.GetWidth(), binding->key.GetHeight(), binding->host_swizzle,
+                native.descriptor_index, native.descriptor_index_signed,
+                texture ? static_cast<void*>(texture->resource()) : nullptr,
+                signed_texture ? static_cast<void*>(signed_texture->resource()) : nullptr);
+  }
+}
