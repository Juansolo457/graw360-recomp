+bool GrawSkipByIndex(uint64_t vs_hash = 0) {
+  // With graw_skip_anchor: count from the scene composite (vs 54BAEAB9C0C06F2E = index 0)
+  // instead of from the swap, so the indices are stable between frames.
+  if (REXCVAR_GET(graw_skip_anchor) && vs_hash == UINT64_C(0x54BAEAB9C0C06F2E)) {
+    GrawFrameDraw() = 0;
+  }
+  const uint32_t n = GrawFrameDraw()++;
+  int64_t from = REXCVAR_GET(graw_skip_draws_from);
+  if (from < 0) return false;
+  if (REXCVAR_GET(graw_skip_anchor) && n >= 0x40000000u) return false;  // before the composite
+  // With graw_skip_step: inactive until 60 s after the first draw, then the start index moves
+  // by graw_skip_step every 3 s (one screenshot every 3 s shows each step).
+  const int32_t step = REXCVAR_GET(graw_skip_step);
+  if (step) {
+    static const auto start = std::chrono::steady_clock::now();
+    const auto t = std::chrono::duration_cast<std::chrono::milliseconds>(
+                       std::chrono::steady_clock::now() - start).count();
+    if (t < 60000) return false;
+    const int64_t k = (t - 60000) / 3000;
+    from += step * k;
+    static int64_t logged_k = -1;
+    if (k != logged_k) {
+      logged_k = k;
+      REXGPU_INFO("GRAW skip step {}: dropping draws {}.. (t {} ms)", k, from, t);
+    }
+  }
+  return int64_t(n) >= from && int64_t(n) <= REXCVAR_GET(graw_skip_draws_to);
+}
