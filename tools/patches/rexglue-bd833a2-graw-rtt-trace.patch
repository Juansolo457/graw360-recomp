+namespace {
+// GRAW #2 trace: what happens to draws into narrow render targets (the video panels).
+void GrawNoteDraw(const RegisterFile& regs, const char* outcome, const void* pixel_shader,
+                  uint32_t normalized_color_mask, uint32_t vertices) {
+  auto si = regs.Get<reg::RB_SURFACE_INFO>();
+  auto ci = regs.Get<reg::RB_COLOR_INFO>(reg::RB_COLOR_INFO::rt_register_indices[0]);
+  std::string key = fmt::format("draw pitch {} base {} fmt {} msaa {}: {}",
+                                uint32_t(si.surface_pitch), uint32_t(ci.color_base),
+                                uint32_t(ci.color_format), uint32_t(si.msaa_samples), outcome);
+  if (!graw_trace::Count(key, 3)) return;
+  REXGPU_INFO(
+      "GRAW trace {}: ps {} color_mask {:08X} normalized {:X} vte {:08X} clip {:08X} "
+      "mode_cntl {:08X} blend0 {:08X} colorcontrol {:08X} depthctl {:08X} modecontrol {:08X} "
+      "window_offset {:08X} window_scissor {:08X} {:08X} screen_scissor {:08X} {:08X} "
+      "vport scale {} {} offset {} {} verts {}",
+      key, pixel_shader, regs[XE_GPU_REG_RB_COLOR_MASK], normalized_color_mask,
+      regs[XE_GPU_REG_PA_CL_VTE_CNTL], regs[XE_GPU_REG_PA_CL_CLIP_CNTL],
+      regs[XE_GPU_REG_PA_SU_SC_MODE_CNTL], regs[XE_GPU_REG_RB_BLENDCONTROL0],
+      regs[XE_GPU_REG_RB_COLORCONTROL], regs[XE_GPU_REG_RB_DEPTHCONTROL],
+      regs[XE_GPU_REG_RB_MODECONTROL], regs[XE_GPU_REG_PA_SC_WINDOW_OFFSET],
+      regs[XE_GPU_REG_PA_SC_WINDOW_SCISSOR_TL], regs[XE_GPU_REG_PA_SC_WINDOW_SCISSOR_BR],
+      regs[XE_GPU_REG_PA_SC_SCREEN_SCISSOR_TL], regs[XE_GPU_REG_PA_SC_SCREEN_SCISSOR_BR],
+      regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_XSCALE), regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_YSCALE),
+      regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_XOFFSET),
+      regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_YOFFSET), vertices);
+}
+// Logs the textures a traced draw samples and starts tracing texture-cache events on them.
+void GrawNoteDrawTextures(const RegisterFile& regs, uint32_t used_texture_mask) {
+  auto si = regs.Get<reg::RB_SURFACE_INFO>();
+  uint32_t index;
+  uint32_t mask = used_texture_mask;
+  while (rex::bit_scan_forward(mask, &index)) {
+    mask &= ~(UINT32_C(1) << index);
+    xenos::xe_gpu_texture_fetch_t fetch = regs.GetTextureFetch(index);
+    uint32_t base = fetch.base_address << 12;
+    uint32_t w = fetch.size_2d.width + 1, h = fetch.size_2d.height + 1;
+    graw_trace::Track(base, std::max(UINT32_C(0x1000), w * h * 4));
+    std::string key = fmt::format("draw pitch {} samples fetch {} base {:08X} {}x{} fmt {}",
+                                  uint32_t(si.surface_pitch), index, base, w, h,
+                                  uint32_t(fetch.format));
+    if (graw_trace::Count(key, 2)) {
+      REXGPU_INFO(
+          "GRAW trace {}: type {} tiled {} pitch {} endian {} swizzle {:03X} fetch {:08X} "
+          "{:08X} {:08X} {:08X} {:08X} {:08X}",
+          key, uint32_t(fetch.type), uint32_t(fetch.tiled), uint32_t(fetch.pitch) << 5,
+          uint32_t(fetch.endianness), uint32_t(fetch.swizzle), fetch.dword_0, fetch.dword_1,
+          fetch.dword_2, fetch.dword_3, fetch.dword_4, fetch.dword_5);
+    }
+  }
+}
