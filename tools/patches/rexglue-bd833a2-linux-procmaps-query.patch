-// Find the mapping entry in /proc/self/maps that contains the given address
+// The kernel's PROCMAP_QUERY ioctl on /proc/self/maps (Linux 6.11): the one mapping that holds an
+// address, found by the kernel without writing out the whole file. Declared here because the
+// build's kernel headers may predate it (include/uapi/linux/fs.h).
+struct ProcmapQuery {
+  uint64_t size;
+  uint64_t query_flags;
+  uint64_t query_addr;
+  uint64_t vma_start;
+  uint64_t vma_end;
+  uint64_t vma_flags;
+  uint64_t vma_page_size;
+  uint64_t vma_offset;
+  uint64_t inode;
+  uint32_t dev_major;
+  uint32_t dev_minor;
+  uint32_t vma_name_size;
+  uint32_t build_id_size;
+  uint64_t vma_name_addr;
+  uint64_t build_id_addr;
+};
+constexpr unsigned long kProcmapQuery = _IOWR('f', 17, ProcmapQuery);
+constexpr uint64_t kProcmapVmaReadable = 0x01;
+constexpr uint64_t kProcmapVmaWritable = 0x02;
+constexpr uint64_t kProcmapVmaExecutable = 0x04;
+constexpr uint64_t kProcmapVmaShared = 0x08;
+
+// 1 found, 0 no mapping holds the address, -1 the kernel has no PROCMAP_QUERY.
+static int QueryEntryForAddress(uintptr_t addr, LinuxMapEntry& out_entry) {
+  // One descriptor for the process's life: the ioctl reads the live address space each call.
+  static const int fd = open("/proc/self/maps", O_RDONLY | O_CLOEXEC);
+  static std::atomic<bool> unsupported{false};
+  if (fd < 0 || unsupported.load(std::memory_order_relaxed))
+    return -1;
+  ProcmapQuery q = {};
+  q.size = sizeof(q);
+  q.query_addr = addr;
+  if (ioctl(fd, kProcmapQuery, &q) != 0) {
+    if (errno == ENOENT)
+      return 0;
+    if (errno == ENOTTY || errno == EINVAL || errno == EOPNOTSUPP)
+      unsupported.store(true, std::memory_order_relaxed);
+    return -1;
+  }
+  out_entry = LinuxMapEntry{};
+  out_entry.start = static_cast<uintptr_t>(q.vma_start);
+  out_entry.end = static_cast<uintptr_t>(q.vma_end);
+  out_entry.perms[0] = (q.vma_flags & kProcmapVmaReadable) ? 'r' : '-';
+  out_entry.perms[1] = (q.vma_flags & kProcmapVmaWritable) ? 'w' : '-';
+  out_entry.perms[2] = (q.vma_flags & kProcmapVmaExecutable) ? 'x' : '-';
+  out_entry.perms[3] = (q.vma_flags & kProcmapVmaShared) ? 's' : 'p';
+  return addr >= out_entry.start && addr < out_entry.end ? 1 : 0;
+}
