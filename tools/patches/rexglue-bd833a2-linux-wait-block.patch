+// A thread in PosixConditionBase::WaitMultiple, registered with every handle it waits on while it
+// sleeps. A handle that becomes signaled wakes the waiters registered with it, and only those.
+struct PosixMultiWaiter {
+  std::mutex mutex;
+  std::condition_variable cond;
+  bool woken = false;  // Protected by mutex.
+
+  void Wake() {
+    std::lock_guard<std::mutex> lock(mutex);
+    woken = true;
+    cond.notify_one();
+  }
+};
+
 class PosixConditionBase {
  public:
+  // With mutex_ held: wakes the single-handle waiters (cond_) and the WaitMultiple waiters.
+  void NotifyAllLocked() {
+    cond_.notify_all();
+    for (auto* waiter : multi_waiters_) {
+      waiter->Wake();
+    }
+  }
+
