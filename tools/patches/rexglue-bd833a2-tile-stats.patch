 namespace rex::graphics {
 
 using namespace rex::graphics::xenos;
 
 namespace {
 
+// Renderer discovery (docs/RENDERER_DISCOVERY.md): with predicated tiling the guest D3D replays
+// a frame's command buffer once per EDRAM tile, so the same packets (same guest address) run
+// several times. Counted on the command processor thread only; summarised at XE_SWAP.
+struct TileStats {
+  uint64_t frames = 0;
+  uint64_t draws = 0, draws_pred = 0, draws_unique = 0, skipped_pred = 0;
+  uint64_t reg_writes = 0, reg_packets = 0, reg_packets_unique = 0, reg_writes_unique = 0;
+  uint64_t bin_selects = 0, tiles = 0;
+  std::unordered_map<uintptr_t, uint32_t> reg_sizes;  // unique type-0 packet -> dwords
+  std::unordered_set<uintptr_t> draw_addrs;
+  std::unordered_set<uint64_t> selects;
+  bool enabled = false, checked = false;
+  bool On() {
+    if (!checked) {
+      checked = true;
+      enabled = REXCVAR_GET(graw_tile_stats);
+    }
+    return enabled;
+  }
+  void EndFrame() {
+    ++frames;
+    draws_unique += draw_addrs.size();
+    reg_packets_unique += reg_sizes.size();
+    for (const auto& [addr, dwords] : reg_sizes) reg_writes_unique += dwords;
+    tiles += selects.size();
+    draw_addrs.clear();
+    reg_sizes.clear();
+    selects.clear();
+    if (frames < 150) return;
+    const double f = double(frames);
+    REXLOG_INFO(
+        "GRAW tiles: per frame {:.0f} draws run ({:.0f} predicated) from {:.0f} unique draw "
+        "packets = x{:.2f}; {:.0f} register writes ({:.0f} type-0 packets) from {:.0f} unique "
+        "({:.0f} packets) = x{:.2f}; {:.0f} predicated packets skipped; {:.1f} bin selects, {:.1f} "
+        "distinct",
+        draws / f, draws_pred / f, draws_unique / f, draws_unique ? double(draws) / draws_unique : 0.0,
+        reg_writes / f, reg_packets / f, reg_writes_unique / f, reg_packets_unique / f,
+        reg_writes_unique ? double(reg_writes) / reg_writes_unique : 0.0, skipped_pred / f,
+        bin_selects / f, tiles / f);
+    *this = TileStats{};
+    checked = enabled = true;
+  }
+};
+TileStats g_tile_stats;
