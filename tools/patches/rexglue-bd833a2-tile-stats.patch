+REXCVAR_DEFINE_BOOL(graw_tile_stats, false, "GRAW",
+                    "Log per-frame PM4 work every 150 frames: draws and register writes run vs "
+                    "unique packets (predicated-tiling replays), skipped predicated packets, bin "
+                    "selects (renderer discovery)")
+    .lifecycle(rex::cvar::Lifecycle::kInitOnly);
