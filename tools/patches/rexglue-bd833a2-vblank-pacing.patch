+        // the timer restarts from now instead of firing the missed ones in a burst.
+        const uint64_t spin_ticks = guest_tick_frequency / 500;  // 2 ms
+        const uint64_t ticks_per_ms = std::max(uint64_t(1), guest_tick_frequency / 1000);
+        uint64_t interval_ticks = REXCVAR_GET(vsync) ? vsync_interval_ticks : no_vsync_interval_ticks;
