-          while (current_time - last_frame_time >= interval_ticks) {
-            MarkVblank();
-            last_frame_time += interval_ticks;
+          if (current_time + spin_ticks < next_vblank) {
+            rex::thread::Sleep(std::chrono::milliseconds(
+                std::max(uint64_t(1), (next_vblank - current_time - spin_ticks) / ticks_per_ms)));
+            continue;
+          }
+          while (current_time < next_vblank && vsync_worker_running_) {
+            rex::thread::MaybeYield();
+            current_time = chrono::Clock::QueryGuestTickCount();
+          }
+          MarkVblank();
+          interval_ticks = REXCVAR_GET(vsync) ? vsync_interval_ticks : no_vsync_interval_ticks;
+          next_vblank += interval_ticks;
+          if (current_time >= next_vblank) {
+            next_vblank = current_time + interval_ticks;
           }
-          rex::thread::Sleep(std::chrono::milliseconds(1));
         }
         return 0;
       }));
