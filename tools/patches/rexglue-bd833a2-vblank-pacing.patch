--- a/src/graphics/graphics_system.cpp
+++ b/src/graphics/graphics_system.cpp
@@ -24,6 +24,7 @@
 #include <rex/graphics/flags.h>
 #include <rex/kernel/xboxkrnl/video.h>
 #include <rex/logging.h>
+#include <rex/platform.h>
 #include <rex/stream.h>
 #include <rex/system/kernel_state.h>
 #include <rex/system/xthread.h>
@@ -157,17 +158,59 @@ X_STATUS GraphicsSystem::SetupGuestGpu(runtime::FunctionDispatcher* function_dis
         uint64_t vsync_interval_ticks =
             std::max(uint64_t(1), uint64_t(double(guest_tick_frequency) / refresh_rate_hz));
         uint64_t no_vsync_interval_ticks = std::max(uint64_t(1), guest_tick_frequency / 1000);
-        uint64_t last_frame_time = chrono::Clock::QueryGuestTickCount();
+        // Each vblank fires at its own deadline: sleep until shortly before it (a sleep can
+        // overshoot by about a timer period), then yield until the exact time. Polling with a
+        // 1 ms sleep and firing every vblank that was due made vblanks late and sometimes two
+        // at once, which games pacing on vblanks show as uneven frames (GRAW at 30 Hz: frames
+        // of 31-35 ms instead of 33.3, and ~14% of 8-12 ms). After a stall longer than a vblank
+        // the timer restarts from now instead of firing the missed ones in a burst.
+        //
+        // On Windows a high-resolution waitable timer wakes within ~0.5 ms, so only the last
+        // 0.25 ms is spun; a 2 ms spin per vblank kept a core busy, which on a power-shared
+        // device (Steam Deck) takes clock from the GPU.
+#if REX_PLATFORM_WIN32
+        HANDLE vblank_timer = CreateWaitableTimerExW(
+            nullptr, nullptr, CREATE_WAITABLE_TIMER_HIGH_RESOLUTION, TIMER_ALL_ACCESS);
+        const uint64_t spin_ticks =
+            vblank_timer ? guest_tick_frequency / 4000 : guest_tick_frequency / 500;
+#else
+        const uint64_t spin_ticks = guest_tick_frequency / 500;  // 2 ms
+#endif
+        const uint64_t ticks_per_ms = std::max(uint64_t(1), guest_tick_frequency / 1000);
+        uint64_t interval_ticks = REXCVAR_GET(vsync) ? vsync_interval_ticks : no_vsync_interval_ticks;
+        uint64_t next_vblank = chrono::Clock::QueryGuestTickCount() + interval_ticks;
         while (vsync_worker_running_) {
           uint64_t current_time = chrono::Clock::QueryGuestTickCount();
-          uint64_t interval_ticks =
-              REXCVAR_GET(vsync) ? vsync_interval_ticks : no_vsync_interval_ticks;
-          while (current_time - last_frame_time >= interval_ticks) {
-            MarkVblank();
-            last_frame_time += interval_ticks;
+#if REX_PLATFORM_WIN32
+          if (vblank_timer && current_time + spin_ticks < next_vblank) {
+            LARGE_INTEGER due;  // relative, in 100 ns units
+            due.QuadPart = -int64_t((next_vblank - current_time - spin_ticks) * 10000000ull /
+                                    guest_tick_frequency);
+            if (SetWaitableTimer(vblank_timer, &due, 0, nullptr, nullptr, FALSE)) {
+              WaitForSingleObject(vblank_timer, INFINITE);
+              continue;
+            }
+          }
+#endif
+          if (current_time + spin_ticks < next_vblank) {
+            rex::thread::Sleep(std::chrono::milliseconds(
+                std::max(uint64_t(1), (next_vblank - current_time - spin_ticks) / ticks_per_ms)));
+            continue;
+          }
+          while (current_time < next_vblank && vsync_worker_running_) {
+            rex::thread::MaybeYield();
+            current_time = chrono::Clock::QueryGuestTickCount();
+          }
+          MarkVblank();
+          interval_ticks = REXCVAR_GET(vsync) ? vsync_interval_ticks : no_vsync_interval_ticks;
+          next_vblank += interval_ticks;
+          if (current_time >= next_vblank) {
+            next_vblank = current_time + interval_ticks;
           }
-          rex::thread::Sleep(std::chrono::milliseconds(1));
         }
+#if REX_PLATFORM_WIN32
+        if (vblank_timer) CloseHandle(vblank_timer);
+#endif
         return 0;
       }));
