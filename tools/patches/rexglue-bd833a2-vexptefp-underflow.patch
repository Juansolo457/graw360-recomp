diff --git a/src/codegen/builders/vector.cpp b/src/codegen/builders/vector.cpp
index 130e244..2b78154 100644
--- a/src/codegen/builders/vector.cpp
+++ b/src/codegen/builders/vector.cpp
@@ -148,6 +148,16 @@ bool build_vexptefp(BuilderContext& ctx) {
   ctx.emit_set_flush_mode(true);
   ctx.println("\t{{");
   ctx.println("\t\tsimde__m128 x = simde_mm_load_ps({}.f32);", vA);
+  // The exponent is built from floor(x) + 127 shifted into the exponent field, which wraps
+  // for x < -127 (2^-130 came out as -8.5e37, 2^-1000 as 1.7e7) and overflows for x >= 128.
+  // Clamp to the representable range first: 2^-127 is a denormal (flushed to zero by the
+  // multiply below under flush mode), 2^128 is +inf, and the hardware estimate returns 0
+  // and +inf there too. NaN stays NaN (SSE min/max return the second operand for a NaN,
+  // so the clamp alone would turn it into 2^-127).
+  ctx.println("\t\tsimde__m128 x_nan = simde_mm_cmpunord_ps(x, x);");
+  ctx.println(
+      "\t\tx = simde_mm_max_ps(simde_mm_min_ps(x, simde_mm_set1_ps(128.0f)), "
+      "simde_mm_set1_ps(-127.0f));");
   ctx.println(
       "\t\tsimde__m128 n = simde_mm_round_ps(x, "
       "SIMDE_MM_FROUND_TO_NEG_INF | SIMDE_MM_FROUND_NO_EXC);");
@@ -163,8 +173,8 @@ bool build_vexptefp(BuilderContext& ctx) {
   ctx.println("\t\tsimde__m128i exp_bits = simde_mm_slli_epi32(");
   ctx.println("\t\t\tsimde_mm_add_epi32(simde_mm_cvttps_epi32(n), simde_mm_set1_epi32(127)), 23);");
   ctx.println(
-      "\t\tsimde_mm_store_ps({}.f32, "
-      "simde_mm_mul_ps(p, simde_mm_castsi128_ps(exp_bits)));",
+      "\t\tsimde_mm_store_ps({}.f32, simde_mm_or_ps(x_nan, "
+      "simde_mm_mul_ps(p, simde_mm_castsi128_ps(exp_bits))));",
       vD);
   ctx.println("\t}}");
   return true;
